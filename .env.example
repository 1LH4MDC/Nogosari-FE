# URL Backend Nogosari (REST API)
# Untuk development lokal:
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Untuk terhubung ke Backend di VPS (gunakan IP VPS atau Domain Nginx):
# NEXT_PUBLIC_API_URL=http://103.xxx.xxx.xxx:3000
# atau jika sudah setup reverse proxy domain / SSL:
# NEXT_PUBLIC_API_URL=https://api.domainanda.com
NEXT_PUBLIC_API_URL=http://localhost:3000

